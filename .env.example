# Example environment for the Cloud Console Portal.
# In production these are sourced from Vault via the External Secrets Operator
# and the Helm chart (see charts/portal). Everything dynamic is an env var.

# ---- Auth.js (NextAuth) ----
# Secret used to encrypt the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32
# Public base URL the browser reaches the portal at (used for OIDC redirects).
AUTH_URL=http://localhost:3000

# ---- SSO / Keycloak (RHBK) OIDC ----
# Same realm issuer the Serverless API trusts, so one login works across APIs.
PORTAL_OIDC_ISSUER=https://sso.internal/realms/serverless
# Confidential client for the portal (Authorization Code + PKCE). Create it in
# Keycloak with a valid redirect URI of {AUTH_URL}/api/auth/callback/keycloak.
PORTAL_OIDC_CLIENT_ID=cloud-console-portal
PORTAL_OIDC_CLIENT_SECRET=change-me
# Token claim carrying the user's groups (matches the API's groupsClaim).
# The portal reads it from the profile, the ID token, and the access token.
# Make sure the portal's Keycloak client has a Group Membership mapper (or the
# groups client scope) that emits this claim - mappers are per-client, so
# enabling it on the Serverless API client alone is not enough.
PORTAL_OIDC_GROUPS_CLAIM=groups
# OIDC scopes requested at login. Some realms only include the groups claim when
# a dedicated scope is asked for; add it here if your realm defines one, e.g.
# "openid profile email groups". Default is the standard set below.
PORTAL_OIDC_SCOPES=openid profile email
# Set to true to log (server-side, on sign-in) which claims the SSO tokens carry
# and where the groups claim was found. Use it to diagnose "no group
# membership", then unset. Prints claim keys and group names, not secrets.
# PORTAL_OIDC_DEBUG=true
# Normalized groups that get the platform-admin role (JSON list).
PORTAL_ADMIN_GROUPS=["platform-admins"]

# ---- Branding ----
PORTAL_PRODUCT_NAME=Cloud Console
PORTAL_ORG_NAME=Platform

# ---- Downstream service APIs ----
# The Serverless API address. Empty leaves the offering as "Coming soon".
PORTAL_SERVERLESS_API_URL=https://serverless-api.example.com
# Future offering (placeholder); leave empty until its API exists.
# PORTAL_STORAGE_API_URL=

# Optional: register/override the whole service catalog as JSON. Each entry may
# set id, name, description, icon, category, apiBaseUrl, enabled. Unknown ids are
# added as new offerings. Overrides the per-service env vars above.
# PORTAL_SERVICES=[{"id":"serverless","apiBaseUrl":"https://serverless-api.example.com","enabled":true}]

# ---- Server ----
PORTAL_PORT=3000
