{
  "name": "cloud-console-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Cloud console portal - a self-service web UI for the on-prem, airgapped platform APIs (Serverless and more).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORTAL_PORT:-3000}",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.10",
    "tar": "^7.5.19"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
